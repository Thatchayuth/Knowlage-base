# ============================================================
# ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values
# ============================================================

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://10.10.0.69:5173


# ============================================================
# MSSQL DATABASE
# ============================================================

DB_HOST=localhost
DB_INSTANCE=MSSQLSERVER
DB_PORT=1433
DB_NAME=KnowledgeDB
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true


# ============================================================
# LDAP / Active Directory
# ============================================================

LDAP_URL=ldap://your-domain-controller:389
LDAP_BASE_DN=DC=yourdomain,DC=com

# Use a dedicated Service Account (NOT personal account)
LDAP_BIND_DN=service_account@yourdomain.com
LDAP_BIND_PASSWORD=your_service_account_password

LDAP_ADMIN_GROUP=ICT

LDAP_TIMEOUT=5000
LDAP_CONNECT_TIMEOUT=5000
LDAP_IDLE_TIMEOUT=60000

# If using LDAPS
# LDAP_TLS_CA_CERT=/path/to/internal-ca.pem


# ============================================================
# PDF Internal Domain Whitelist (comma-separated)
# ============================================================

PDF_ALLOWED_DOMAINS=fileserver.internal,docs.internal


# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_ADMIN_MAX=500


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info
LOG_DIR=./server/logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d

CORS_ORIGIN = http://linebot-ncr.dyndns.org:48089
