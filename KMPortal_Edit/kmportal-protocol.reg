Windows Registry Editor Version 5.00

; ==============================================================
;  KM Portal — Custom URL Protocol Handler
;  ─────────────────────────────────────────────────────────────
;  Registers the "kmportal://" URL scheme so links from the web
;  portal can open files/programs locally on the Windows client.
;
;  Example URL from the web:
;    kmportal://open?type=powerbi&path=%5C%5Cserver%5Cshare%5Creport.pbix
;
;  After importing this .reg, copy:
;    C:\KMPortal\kmportal-launcher.ps1
;  (or change the path below to wherever you placed the script)
;
;  IMPORTANT — The launcher path is HARD-CODED below.
;  Edit C:\\KMPortal\\kmportal-launcher.ps1 if you put it elsewhere.
;  Backslashes inside .reg values must be doubled (\\).
;
;  v2 — this now writes to HKEY_CURRENT_USER\Software\Classes
;  instead of HKEY_CLASSES_ROOT:
;    - No UAC prompt. A standard user can import it.
;    - Deployable to every machine at once with Group Policy
;      Preferences > Registry (User Configuration), so nobody has
;      to install it by hand.
;    - HKCU\Software\Classes takes precedence over the machine-wide
;      HKEY_LOCAL_MACHINE\SOFTWARE\Classes entry, so an older
;      install stays in place and is simply overridden.
;
;  -NoLogo -NonInteractive keep the hidden PowerShell window from
;  waiting on anything; the launcher reports errors through msg.exe.
; ==============================================================

[HKEY_CURRENT_USER\Software\Classes\kmportal]
@="URL:KM Portal Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\kmportal\DefaultIcon]
@="%SystemRoot%\\System32\\shell32.dll,3"

[HKEY_CURRENT_USER\Software\Classes\kmportal\shell]

[HKEY_CURRENT_USER\Software\Classes\kmportal\shell\open]

[HKEY_CURRENT_USER\Software\Classes\kmportal\shell\open\command]
@="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File \"C:\\KMPortal\\kmportal-launcher.ps1\" \"%1\""
